<Window x:Class="StudioUSB.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StudioUSB" Height="820" Width="930" MinHeight="730" MinWidth="820"
        WindowStartupLocation="CenterScreen" Background="#FFF5F7FA">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="StudioUSB" FontSize="30" FontWeight="SemiBold" Foreground="#FF172033" />
            <TextBlock Margin="0,5,0,0" Foreground="#FF5F6B7A"
                       Text="Pripraví fotografie na web aj tlač a bezpečne ich uloží na USB." />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Text="Zdrojový adresár" />
            <TextBox x:Name="SourceTextBox" Grid.Column="1" Margin="0,0,10,0" IsReadOnly="True" />
            <Button x:Name="BrowseButton" Grid.Column="2" Content="Vybrať…" Click="BrowseButton_Click" />
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Text="Cieľové USB" />
            <ComboBox x:Name="DriveComboBox" Grid.Column="1" Margin="0,0,10,0" DisplayMemberPath="DisplayName" />
            <Button x:Name="RefreshButton" Grid.Column="2" Content="Obnoviť" Click="RefreshButton_Click" />
        </Grid>

        <Border Grid.Row="3" Padding="14" Margin="0,0,0,12" CornerRadius="8" Background="White"
                BorderBrush="#FFDDE3EA" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.ColumnSpan="4" Margin="0,0,0,10" FontWeight="SemiBold"
                           Foreground="#FF172033" Text="Nastavenia fotografií" />

                <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="Kvalita JPEG" />
                <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,24,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="55" />
                    </Grid.ColumnDefinitions>
                    <Slider x:Name="QualitySlider" Grid.Column="0" Minimum="1" Maximum="100" Value="80"
                            TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" TextAlignment="Right"
                               Text="{Binding ElementName=QualitySlider, Path=Value, StringFormat={}{0:F0} %}" />
                </Grid>

                <TextBlock Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Text="Prípona názvu" />
                <TextBox x:Name="SuffixTextBox" Grid.Row="1" Grid.Column="3" Margin="0,0,0,8" MaxLength="64" Text="-websize" />

                <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="Adresár web" />
                <TextBox x:Name="WebFolderTextBox" Grid.Row="2" Grid.Column="1" Margin="0,0,24,0" MaxLength="64" Text="WEBSIZE" />
                <TextBlock Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" Text="Adresár tlač" />
                <TextBox x:Name="PrintFolderTextBox" Grid.Row="2" Grid.Column="3" MaxLength="64" Text="PRINTSIZE" />
            </Grid>
        </Border>

        <Border Grid.Row="4" Padding="14" Margin="0,0,0,12" CornerRadius="8" Background="White"
                BorderBrush="#FFDDE3EA" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="205" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <CheckBox x:Name="FormatCheckBox" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0"
                          Content="Pred spracovaním naformátovať USB" Checked="FormatCheckBox_Changed" Unchecked="FormatCheckBox_Changed" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Text="Názov:" />
                    <TextBox x:Name="VolumeLabelTextBox" Width="125" MaxLength="11" Text="FOTO" IsEnabled="False" />
                </StackPanel>
                <TextBlock Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right" Margin="0,0,8,0"
                           Text="Max. veľkosť média:" />
                <ComboBox x:Name="FormatLimitComboBox" Grid.Column="3" Width="110" HorizontalAlignment="Left"
                          DisplayMemberPath="DisplayName" SelectedValuePath="GiB" IsEnabled="False"
                          ToolTip="FAT32 do 32 GiB, exFAT nad 32 GiB" />
            </Grid>
        </Border>

        <Border Grid.Row="5" Padding="12" Margin="0,0,0,12" CornerRadius="8" Background="#FFEAF3FF"
                BorderBrush="#FFBFD8F5" BorderThickness="1">
            <TextBlock Foreground="#FF24476B" TextWrapping="Wrap"
                       Text="Nastavenia sa automaticky ukladajú; zdrojový adresár sa neukladá. Formátovanie používa FAT32 do 32 GiB a exFAT nad 32 GiB." />
        </Border>

        <Grid Grid.Row="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <ProgressBar x:Name="ProgressBar" Grid.Row="0" Height="18" Minimum="0" Maximum="100" Margin="0,0,0,10" />
            <TextBox x:Name="LogTextBox" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     FontFamily="Consolas" FontSize="12" Background="White" />
        </Grid>

        <Grid Grid.Row="7" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusTextBlock" Grid.Column="0" VerticalAlignment="Center" Foreground="#FF445064" Text="Pripravené" />
            <Button x:Name="CancelButton" Grid.Column="1" Margin="0,0,10,0" Content="Zrušiť" IsEnabled="False" Click="CancelButton_Click" />
            <Button x:Name="StartButton" Grid.Column="2" MinWidth="150" Background="#FF1769AA" Foreground="White"
                    FontWeight="SemiBold" Content="Spustiť" Click="StartButton_Click" />
        </Grid>
    </Grid>
</Window>
