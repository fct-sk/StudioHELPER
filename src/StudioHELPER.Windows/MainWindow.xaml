<Window x:Class="StudioHELPER.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StudioHELPER" Width="1200" Height="900" MinWidth="960" MinHeight="700"
        WindowStartupLocation="CenterScreen" Background="#FFF5F7FA">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="84" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#FF172033">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="8,14,8,0">
                    <Button x:Name="HomeButton" Height="62" Margin="0,0,0,10" Click="HomeButton_Click"
                            Background="#FF2B3A55" BorderThickness="0" Foreground="White" Cursor="Hand">
                        <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="27" HorizontalAlignment="Center" />
                    </Button>
                    <Separator Margin="8,0,8,10" Background="#FF526078" />
                    <Button x:Name="StudioUsbButton" Height="70" Click="StudioUsbButton_Click"
                            Background="Transparent" BorderThickness="0" Foreground="White" Cursor="Hand">
                        <StackPanel>
                            <TextBlock Text="&#xE88E;" FontFamily="Segoe MDL2 Assets" FontSize="26" HorizontalAlignment="Center" />
                            <TextBlock Text="USB" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,5,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <TextBlock Grid.Row="2" Text="0.1.0" Foreground="#FF8E99AA" FontSize="11"
                           HorizontalAlignment="Center" Margin="0,0,0,14" />
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="White" BorderBrush="#FFDDE3EA" BorderThickness="0,0,0,1">
                <TextBlock x:Name="PageTitleText" Margin="26,0" VerticalAlignment="Center"
                           FontSize="21" FontWeight="SemiBold" Foreground="#FF172033" />
            </Border>
            <ContentControl x:Name="ContentHost" Grid.Row="1" />
        </Grid>
    </Grid>
</Window>
