<UserControl x:Class="StudioHELPER.Windows.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FFF5F7FA">
    <Grid>
        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="36" Padding="18"
                Background="White" BorderBrush="#FFDDE3EA" BorderThickness="1" CornerRadius="8">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="LanguageLabel" VerticalAlignment="Center" Margin="0,0,14,0" FontWeight="SemiBold" />
                <ComboBox x:Name="LanguageComboBox" Width="170" DisplayMemberPath="DisplayName" SelectedValuePath="Value"
                          SelectionChanged="LanguageComboBox_SelectionChanged" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
