<UserControl x:Class="StudioHELPER.Windows.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FFF5F7FA">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36">
            <Border HorizontalAlignment="Left" Padding="22" MinWidth="460"
                    Background="White" BorderBrush="#FFDDE3EA" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <CheckBox x:Name="RunAtStartupCheckBox" Margin="0,0,0,18"
                              Checked="SettingChanged" Unchecked="SettingChanged" />
                    <CheckBox x:Name="MinimizeToTrayCheckBox"
                              Checked="SettingChanged" Unchecked="SettingChanged" />
                </StackPanel>
            </Border>

            <Border HorizontalAlignment="Left" Margin="0,18,0,0" Padding="22" MinWidth="460"
                    Background="White" BorderBrush="#FFDDE3EA" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock x:Name="UpdatesTitleText" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <TextBlock x:Name="CurrentVersionText" Foreground="#FF5F6B7A" Margin="0,0,0,10" />
                    <TextBlock x:Name="UpdateStatusText" TextWrapping="Wrap" Margin="0,0,0,12" />
                    <ProgressBar x:Name="UpdateProgressBar" Height="16" Minimum="0" Maximum="100"
                                 Visibility="Collapsed" Margin="0,0,0,12" />
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="CheckUpdatesButton" Padding="14,8" Margin="0,0,10,0"
                                Click="CheckUpdatesButton_Click" />
                        <Button x:Name="InstallUpdateButton" Padding="14,8" Visibility="Collapsed"
                                Click="InstallUpdateButton_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
